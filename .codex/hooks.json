{
  "description": "Codex mirror of .claude/settings.json hooks. Script lives in .claude/hooks.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/stop-verify.mjs\"",
            "commandWindows": "node .claude/hooks/stop-verify.mjs",
            "timeout": 300,
            "statusMessage": "typecheck + eslint on changed ts/tsx"
          }
        ]
      }
    ]
  }
}
